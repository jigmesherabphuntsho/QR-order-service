datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  output        = "../../backend/node_modules/.prisma/client"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

model Restaurant {
  id           String     @id @default(uuid())
  name         String     @default("Gourmet Haven")
  tagline      String     @default("Authentic Flavors & Fresh Ingredients")
  openingHours String     @default("10:00 AM - 10:00 PM")
  phone        String     @default("+1 (555) 234-5678")
  email        String     @default("info@gourmethaven.com")
  address      String     @default("123 Culinary St, Foodville")
  currency     String     @default("Nu ")
  tableCount   Int        @default(12)
  admins       Admin[]
  tables       Table[]
  categories   Category[]
  menuItems    MenuItem[]
  orders       Order[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model Admin {
  id           String      @id @default(uuid())
  email        String      @unique
  password     String
  name         String
  role         String      @default("ADMIN")
  restaurantId String?
  restaurant   Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model Table {
  id           String      @id @default(uuid())
  number       Int
  qrCodeUrl    String?
  isOccupied   Boolean     @default(false)
  restaurantId String?
  restaurant   Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@unique([number, restaurantId])
}

model Category {
  id           String      @id @default(uuid())
  name         String
  slug         String
  description  String?
  sortOrder    Int         @default(0)
  restaurantId String?
  restaurant   Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  items        MenuItem[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@unique([slug, restaurantId])
}

model MenuItem {
  id             String      @id @default(uuid())
  name           String
  description    String
  price          Float
  imageUrl       String
  categoryId     String
  category       Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  restaurantId   String?
  restaurant     Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  isAvailable    Boolean     @default(true)
  isTodaySpecial Boolean     @default(true)
  sortOrder      Int         @default(0)
  orderItems     OrderItem[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

model Order {
  id           String      @id @default(uuid())
  orderNumber  Int
  tableNumber  Int
  customerName String?     @default("Guest")
  totalAmount  Float
  status       String      @default("PENDING")
  notes        String?
  restaurantId String?
  restaurant   Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  items        OrderItem[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model OrderItem {
  id         String   @id @default(uuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])
  quantity   Int
  price      Float
  notes      String?
}
